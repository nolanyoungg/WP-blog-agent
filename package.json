{
  "name": "wp-blog-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/src/cli/index.js",
    "once": "npm run build && node dist/src/cli/index.js once",
    "worker": "npm run build && node dist/src/cli/index.js worker",
    "relay": "npm run build && node dist/src/cli/relay.js",
    "formats:validate": "npm run build && node dist/src/cli/formats.js validate",
    "formats:sync": "npm run build && node dist/src/cli/formats.js sync",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fflate": "^0.8.3",
    "marked": "^15.0.12",
    "pdfkit": "^0.19.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
