{
  "name": "wp-blog-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli/index.js",
    "once": "npm run build && node dist/src/cli/index.js once",
    "worker": "npm run build && node dist/src/cli/index.js worker",
    "relay": "npm run build && node dist/src/cli/relay.js",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "dry-run:fixture": "npm run build && node dist/src/cli/index.js once --dry-run --tracker tests/fixtures/wordpress-blog-content-tracker.xlsx"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "marked": "^15.0.12",
    "sanitize-html": "^2.17.6",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
