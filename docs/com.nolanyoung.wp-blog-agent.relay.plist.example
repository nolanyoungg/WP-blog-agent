<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nolanyoung.wp-blog-agent.relay</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/node</string><string>/ABSOLUTE/PATH/WP-blog-agent/dist/src/cli/relay.js</string></array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/WP-blog-agent</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/wp-blog-agent-relay.out</string><key>StandardErrorPath</key><string>/tmp/wp-blog-agent-relay.err</string>
</dict></plist>
