# LM Studio only. This agent never contacts a cloud model provider.
LMSTUDIO_BASE_URL=http://192.168.1.35:1234
LMSTUDIO_API_TOKEN=
LMSTUDIO_PRIMARY_MODEL=openai/gpt-oss-20b
LMSTUDIO_ALLOW_FALLBACK_LOAD=true
LMSTUDIO_TIMEOUT_MS=120000
LMSTUDIO_RETRY_LIMIT=1

TRACKER_PATH=manual-files/wordpress-blog-content-tracker.xlsx
DRAFTS_DIR=data/drafts
RUNS_DIR=data/runs
POLL_INTERVAL_MS=60000

# macOS only: `macos` uses Messages and reads its local chat database; `dry-run` sends nothing.
IMESSAGE_ADAPTER=macos
IMESSAGE_RECIPIENT=
IMESSAGE_CHAT_DB=$HOME/Library/Messages/chat.db

WORDPRESS_BASE_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_POST_STATUS=draft
WORDPRESS_ALLOW_HTTP=false
