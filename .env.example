# LM Studio only. This agent never contacts a cloud model provider.
LMSTUDIO_BASE_URL=http://192.168.1.35:1234
LMSTUDIO_API_TOKEN=
LMSTUDIO_PRIMARY_MODEL=openai/gpt-oss-20b
LMSTUDIO_ALLOW_FALLBACK_LOAD=true
LMSTUDIO_TIMEOUT_MS=300000
LMSTUDIO_MAX_TOKENS=6000
LMSTUDIO_RETRY_LIMIT=3

TRACKER_PATH=manual-files/wordpress-blog-content-tracker.xlsx
BLOG_FORMATS_DIR=config/blog-formats
DRAFTS_DIR=data/drafts
RUNS_DIR=data/runs
POLL_INTERVAL_MS=60000

# `macos` uses local Messages; `relay` calls a token-protected relay on a separate Mac; `dry-run` sends nothing.
IMESSAGE_ADAPTER=macos
IMESSAGE_RECIPIENT=
IMESSAGE_CHAT_DB=$HOME/Library/Messages/chat.db
IMESSAGE_ATTACHMENT_OUTBOX=$HOME/Pictures/WP Blog Agent Outbox
IMESSAGE_DELIVERY_TIMEOUT_MS=60000
IMESSAGE_DELIVERY_POLL_MS=250
IMESSAGE_RELAY_URL=
IMESSAGE_RELAY_TOKEN=
IMESSAGE_RELAY_TIMEOUT_MS=90000
# Used only by `npm run relay` on the Mac signed into Messages. Keep the default for a local tunnel.
IMESSAGE_RELAY_LISTEN_HOST=127.0.0.1
IMESSAGE_RELAY_LISTEN_PORT=8787

WORDPRESS_BASE_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_POST_STATUS=draft
WORDPRESS_ALLOW_HTTP=false
